import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/cmp",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/math",
  "moonbitlang/core/path",
  "moonbitlang/core/random",
  "moonbitlang/pdflite",
  "moonbitlang/pdflite/async_io" @pdf_io,
  "moonbitlang/pdflite/bookmark",
  "moonbitlang/pdflite/content/colour",
  "moonbitlang/pdflite/date" @pdf_date,
  "moonbitlang/pdflite/geometry",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": true,
  "native-stub": [ "wk_bridge.m" ],
  link: {
    "native": {
      "stub-cc-flags": "-ObjC -fblocks",
      "cc-link-flags": "-framework Cocoa -framework WebKit -framework UniformTypeIdentifiers",
    },
  },
)
