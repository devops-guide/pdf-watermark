{
  "name": "@xbl/pdf-watermark",
  "version": "1.0.8",
  "description": "Proton PDF watermark desktop app and MCP server",
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:proton": "node scripts/install-proton.js",
    "build:frontend": "node scripts/build-frontend.js",
    "start": "npm run build:frontend && proton_cli dev",
    "build": "proton_cli build -- --release",
    "package": "proton_cli package --release",
    "test": "node --test test/testMain.js"
  },
  "keywords": [
    "pdf",
    "watermark"
  ],
  "author": "xbl",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "bin": {
    "@xbl/pdf-watermark": "mcp-server.js"
  },
  "files": [
    "mcp-server.js",
    "main.js",
    "watermark.js",
    "fonts"
  ]
}
